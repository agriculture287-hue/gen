# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BLOB_READ_WRITE_TOKEN: Required for Vercel Blob cloud storage operations (put, get, list).
# Provided by Vercel Blob in your project dashboard or storage settings.
BLOB_READ_WRITE_TOKEN=""

# BLOB_STORE_ID: Optional store identifier for Vercel Blob.
BLOB_STORE_ID=""

# ADMIN_PASSWORD: Password to access the /admin update panel.
ADMIN_PASSWORD=""

# GREETING: Optional custom greeting string returned by /welcome
GREETING="hello world"

# SUPABASE_URL: URL of your Supabase project
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Anonymous public API key for your Supabase project
SUPABASE_ANON_KEY=""

# GenMusic Link Redirection & Deep Linking
GENMUSIC_APP_SCHEME="genmusic"
GENMUSIC_PACKAGE_NAME="in.gen.agrigence"
GENMUSIC_PLAY_STORE_URL="https://play.google.com/store/apps/details?id=in.gen.agrigence"
GENMUSIC_APP_STORE_URL="https://apps.apple.com/app/genmusic/id123456789"
