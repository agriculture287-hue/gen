{
  "version": 2,
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300" },
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/app-version.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300" },
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/download/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/version.json", "destination": "/version.json" },
    { "source": "/download/genmusic.apk", "destination": "https://github.com/genmusic/releases/releases/download/v2.5.0/GEN_MUSIC_v2.5.0.apk" },
    { "source": "/download/genmusic-setup.exe", "destination": "https://github.com/genmusic/releases/releases/download/v2.5.0/GEN_MUSIC_Setup_v2.5.0.exe" },
    { "source": "/download/genmusic.dmg", "destination": "https://github.com/genmusic/releases/releases/download/v2.5.0/GEN_MUSIC_v2.5.0_Universal.dmg" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
