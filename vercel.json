{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "X-Requested-With, Content-Type, Accept, Authorization" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/app-version.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=0, must-revalidate" }
      ]
    },
    {
      "source": "/download/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/api", "destination": "/api/index.ts" },
    { "source": "/welcome", "destination": "/api/index.ts" },
    { "source": "/version.json", "destination": "/api/index.ts" },
    { "source": "/app-version.json", "destination": "/api/index.ts" },
    { "source": "/download/(.*)", "destination": "/api/index.ts" },
    { "source": "/share/(.*)", "destination": "/api/index.ts" },
    { "source": "/sw.js", "destination": "/api/index.ts" },
    { "source": "/service-worker.js", "destination": "/api/index.ts" },
    { "source": "/((?!api/|version\\.json|app-version\\.json|download/|share/|sw\\.js|service-worker\\.js|assets/|favicon\\.ico|robots\\.txt|sitemap\\.xml).*+)", "destination": "/index.html" }
  ]
}
